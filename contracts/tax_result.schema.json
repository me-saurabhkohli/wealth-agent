{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"description":"Output contract of the tax worker. recommended_trades, tax_savings_estimate, and drift_reduction are the fields the blueprint names; the rest are reporting fields the Oracle implementation adds. term classifies each sale as short or long term from the lot acquisition date; gain_loss_breakdown sums realized gains and losses by that classification; skipped_lots records loss lots the optimizer left alone because a sale would have fallen inside the wash sale window.","properties":{"drift_after_pct":{"minimum":0,"type":"number"},"drift_before_pct":{"minimum":0,"type":"number"},"drift_reduction":{"type":"number"},"gain_loss_breakdown":{"additionalProperties":false,"properties":{"long_term_net":{"type":"number"},"short_term_net":{"type":"number"}},"required":["short_term_net","long_term_net"],"type":"object"},"net_realized_gain_loss":{"type":"number"},"recommended_trades":{"items":{"additionalProperties":false,"properties":{"lot_cost_basis":{"type":["number","null"]},"price":{"minimum":0,"type":"number"},"proceeds":{"minimum":0,"type":"number"},"realized_gain_loss":{"type":"number"},"shares":{"minimum":0,"type":"number"},"side":{"enum":["buy","sell"],"type":"string"},"term":{"enum":["short","long",null],"type":["string","null"]},"ticker":{"type":"string"}},"required":["ticker","side","shares","price","proceeds","realized_gain_loss","lot_cost_basis","term"],"type":"object"},"type":"array"},"skipped_lots":{"items":{"additionalProperties":false,"properties":{"acquired":{"type":"string"},"lot_cost_basis":{"type":"number"},"reason":{"type":"string"},"shares":{"minimum":0,"type":"number"},"ticker":{"type":"string"}},"required":["ticker","shares","lot_cost_basis","acquired","reason"],"type":"object"},"type":"array"},"tax_savings_estimate":{"minimum":0,"type":"number"}},"required":["recommended_trades","tax_savings_estimate","drift_reduction"],"title":"TaxResult","type":"object"}