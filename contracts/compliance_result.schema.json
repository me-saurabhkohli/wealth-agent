{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"description":"Output contract of the compliance worker: an overall status, one check entry per rule in the rules engine, and the list of failure reasons. Rule ids are the ones declared as data in adapters/compliance.py.","properties":{"checks":{"items":{"additionalProperties":false,"properties":{"detail":{"type":"string"},"rule":{"enum":["concentration_limit","wash_sale_window","drift_tolerance","sell_within_holdings","cash_residual"],"type":"string"},"status":{"enum":["pass","fail"],"type":"string"}},"required":["rule","status","detail"],"type":"object"},"type":"array"},"reasons":{"items":{"type":"string"},"type":"array"},"status":{"enum":["pass","fail"],"type":"string"}},"required":["status","checks","reasons"],"title":"ComplianceResult","type":"object"}